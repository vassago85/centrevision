# CentreVision production environment file
# Copy to /opt/centrevision/.env and fill in secrets.
# Anything left blank falls back to the compose defaults where safe.

# ── App identity ───────────────────────────────────────────────────────
APP_NAME=CentreVision
APP_ENV=production
APP_DEBUG=false

# Public URL used by mailables, invoice links, verify pages, etc.
APP_URL=https://centrevision.co.za

# Generate once with:
#   docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Host port that Nginx Proxy Manager will forward to. Change if 8092 clashes
# with something else on the box (NRAPA is on 8085).
APP_PORT=8092

# ── Postgres ───────────────────────────────────────────────────────────
DB_DATABASE=centrevision
DB_USERNAME=centrevision
DB_PASSWORD=change-me-strong-password

# ── Mail (Mailgun / SMTP) ──────────────────────────────────────────────
# Leave MAIL_MAILER=log until real SMTP creds are ready — outbound mail
# then lands in storage/logs/laravel.log so nothing gets sent by mistake.
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@centrevision.co.za
MAIL_FROM_NAME=CentreVision
TRAFFICFLOW_BILLING_EMAIL=billing@centrevision.co.za

# ── Paystack (billing) ─────────────────────────────────────────────────
# Optional at boot — PaymentProcessor falls back to a fake gateway when
# these are blank, which is what the demo uses.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
