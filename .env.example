APP_NAME=CentreVision
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_ZA
APP_TIMEZONE=Africa/Johannesburg

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=trafficflow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@centrevision.co.za"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- TrafficFlow ---

# Directory cameras push plate-capture files into (FTP drop / local mount).
# Leave blank to use storage/app/private/hikvision-drop, which is where the
# `hik-drop` docker volume is mounted by docker-compose.yml. Only set this if
# the deployment stores the FTP drop somewhere else.
TRAFFICFLOW_PLATE_DROP_PATH=

# Ingestion tuning
TRAFFICFLOW_DEDUPE_WINDOW_SECONDS=20
TRAFFICFLOW_FUZZY_MATCH_ENABLED=true
TRAFFICFLOW_ALERT_STREAM_TIMEOUT=0
TRAFFICFLOW_ALERT_STREAM_RETRY_BASE=5
TRAFFICFLOW_ALERT_STREAM_RETRY_MAX=300

# Visit matching / security defaults (per-site values override these)
TRAFFICFLOW_ORPHAN_AFTER_HOURS=12
TRAFFICFLOW_DWELL_ALERT_HOURS=4

# Recurring (staff) plate detection defaults
TRAFFICFLOW_RECURRING_WINDOW_DAYS=28
TRAFFICFLOW_RECURRING_MIN_WEEKDAY_RATIO=0.8
TRAFFICFLOW_RECURRING_MAX_ARRIVAL_STDDEV_MINUTES=30

# POPIA data retention default (days)
TRAFFICFLOW_RETENTION_DAYS=365

# Billing
TRAFFICFLOW_CURRENCY=ZAR
TRAFFICFLOW_VARIABLE_RATE_PER_CAMERA_PER_SUBUSER=20.00
TRAFFICFLOW_PARTNER_COMMISSION_RATE=0.20

# Payment gateway: paystack | fake
PAYMENT_GATEWAY=fake
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
